{
  "name": "testingsolution",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "expo": "~50.0.5",
    "expo-status-bar": "~1.11.1",
    "jest-expo": "~50.0.2",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-safe-area-context": "^4.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.3",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.2",
    "react-test-renderer": "^18.2.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "App.js",
      "components/MealDisplay.js",
      "services/mealService.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
